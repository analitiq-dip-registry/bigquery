{
  "$schema": "https://schemas.analitiq.ai/type-map-read/latest.json",
  "direction": "read",
  "rules": [
    {
      "match": "exact",
      "native_type": "INT64",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "INT",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "SMALLINT",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "INTEGER",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "BIGINT",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "TINYINT",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "BYTEINT",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "FLOAT64",
      "arrow_type": "Float64"
    },
    {
      "match": "exact",
      "native_type": "FLOAT",
      "arrow_type": "Float64"
    },
    {
      "match": "exact",
      "native_type": "BOOL",
      "arrow_type": "Boolean"
    },
    {
      "match": "exact",
      "native_type": "BOOLEAN",
      "arrow_type": "Boolean"
    },
    {
      "match": "exact",
      "native_type": "STRING",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "BYTES",
      "arrow_type": "Binary"
    },
    {
      "match": "exact",
      "native_type": "DATE",
      "arrow_type": "Date32"
    },
    {
      "match": "exact",
      "native_type": "DATETIME",
      "arrow_type": "Timestamp(MICROSECOND)"
    },
    {
      "match": "exact",
      "native_type": "TIME",
      "arrow_type": "Time64(MICROSECOND)"
    },
    {
      "match": "exact",
      "native_type": "TIMESTAMP",
      "arrow_type": "Timestamp(MICROSECOND, UTC)"
    },
    {
      "match": "exact",
      "native_type": "NUMERIC",
      "arrow_type": "Decimal128(38, 9)"
    },
    {
      "match": "exact",
      "native_type": "DECIMAL",
      "arrow_type": "Decimal128(38, 9)"
    },
    {
      "match": "exact",
      "native_type": "BIGNUMERIC",
      "arrow_type": "Decimal256(76, 38)"
    },
    {
      "match": "exact",
      "native_type": "BIGDECIMAL",
      "arrow_type": "Decimal256(76, 38)"
    },
    {
      "match": "exact",
      "native_type": "GEOGRAPHY",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "JSON",
      "arrow_type": "Json"
    },
    {
      "match": "exact",
      "native_type": "INTERVAL",
      "arrow_type": "Utf8"
    },
    {
      "match": "regex",
      "native_type": "^NUMERIC\\(\\s*(?<p>\\d+)\\s*,\\s*(?<s>\\d+)\\s*\\)$",
      "arrow_type": "Decimal128(${p}, ${s})"
    },
    {
      "match": "regex",
      "native_type": "^DECIMAL\\(\\s*(?<p>\\d+)\\s*,\\s*(?<s>\\d+)\\s*\\)$",
      "arrow_type": "Decimal128(${p}, ${s})"
    },
    {
      "match": "regex",
      "native_type": "^BIGNUMERIC\\(\\s*(?<p>\\d+)\\s*,\\s*(?<s>\\d+)\\s*\\)$",
      "arrow_type": "Decimal256(${p}, ${s})"
    },
    {
      "match": "regex",
      "native_type": "^BIGDECIMAL\\(\\s*(?<p>\\d+)\\s*,\\s*(?<s>\\d+)\\s*\\)$",
      "arrow_type": "Decimal256(${p}, ${s})"
    },
    {
      "match": "regex",
      "native_type": "^NUMERIC\\(\\s*(?<p>\\d+)\\s*\\)$",
      "arrow_type": "Decimal128(${p}, 0)"
    },
    {
      "match": "regex",
      "native_type": "^DECIMAL\\(\\s*(?<p>\\d+)\\s*\\)$",
      "arrow_type": "Decimal128(${p}, 0)"
    },
    {
      "match": "regex",
      "native_type": "^BIGNUMERIC\\(\\s*(?<p>\\d+)\\s*\\)$",
      "arrow_type": "Decimal256(${p}, 0)"
    },
    {
      "match": "regex",
      "native_type": "^BIGDECIMAL\\(\\s*(?<p>\\d+)\\s*\\)$",
      "arrow_type": "Decimal256(${p}, 0)"
    },
    {
      "match": "regex",
      "native_type": "^STRING\\(\\s*\\d+\\s*\\)$",
      "arrow_type": "Utf8"
    },
    {
      "match": "regex",
      "native_type": "^BYTES\\(\\s*\\d+\\s*\\)$",
      "arrow_type": "Binary"
    },
    {
      "match": "regex",
      "native_type": "^ARRAY<.*>$",
      "arrow_type": "Json"
    },
    {
      "match": "regex",
      "native_type": "^STRUCT<.*>$",
      "arrow_type": "Json"
    },
    {
      "match": "regex",
      "native_type": "^RANGE<.*>$",
      "arrow_type": "Json"
    }
  ]
}
